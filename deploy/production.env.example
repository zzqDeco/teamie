# Template only. Create /srv/teamie/config/production.env as teamie-deploy, mode 0600.
# Use independent random URL-safe values (openssl rand -hex 32); replace every marker.
# Do not commit the completed file. Never run Compose config directly in shared logs.
SITE_ADDRESS=https://YOUR_PUBLIC_IP
APP_ORIGIN=https://YOUR_PUBLIC_IP
TLS_CONFIG_FILE=/srv/teamie/tls/issuer.caddy
TLS_CERT_DIR=/srv/teamie/tls/certs
FEATURE_FLAGS_PATH=/srv/teamie/config/feature-flags.json
POSTGRES_ADMIN_PASSWORD=REPLACE_ADMIN_PASSWORD
POSTGRES_IDENTITY_PASSWORD=REPLACE_IDENTITY_PASSWORD
POSTGRES_CHAT_PASSWORD=REPLACE_CHAT_PASSWORD
IDENTITY_DATABASE_URL=postgres://teamie_identity:REPLACE_IDENTITY_PASSWORD@postgres:5432/teamie_identity?sslmode=disable
CHAT_DATABASE_URL=postgres://teamie_chat:REPLACE_CHAT_PASSWORD@postgres:5432/teamie_chat?sslmode=disable
# Deployment registration code, separate from per-workspace invitations.
REGISTRATION_CODE=REPLACE_REGISTRATION_CODE
