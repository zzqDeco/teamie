# Template only. Create /srv/teamie/config/production.env as teamie-deploy, mode 0600.
# Use independent random URL-safe values (openssl rand -hex 32); replace every marker.
# Do not commit the completed file. Never run Compose config directly in shared logs.
SITE_ADDRESS=https://YOUR_PUBLIC_IP
APP_ORIGIN=https://YOUR_PUBLIC_IP
# Host/IP only (no scheme or port); selects the cert for IP clients without SNI.
TLS_SERVER_NAME=YOUR_PUBLIC_IP
TLS_CONFIG_FILE=/srv/teamie/tls/issuer.caddy
TLS_CERT_DIR=/srv/teamie/tls/certs
FEATURE_FLAGS_PATH=/srv/teamie/config/feature-flags.json
POSTGRES_ADMIN_PASSWORD=REPLACE_ADMIN_PASSWORD
POSTGRES_IDENTITY_PASSWORD=REPLACE_IDENTITY_PASSWORD
POSTGRES_CHAT_PASSWORD=REPLACE_CHAT_PASSWORD
IDENTITY_DATABASE_URL=postgres://teamie_identity:REPLACE_IDENTITY_PASSWORD@postgres:5432/teamie_identity?sslmode=disable
CHAT_DATABASE_URL=postgres://teamie_chat:REPLACE_CHAT_PASSWORD@postgres:5432/teamie_chat?sslmode=disable
# Optional first-account bootstrap code; this is the default when unset/empty.
# The first account becomes platform admin. This code stops working afterward;
# subsequent accounts require admin-generated, single-use registration invites.
BOOTSTRAP_INVITE_CODE=teamie-bootstrap

# Agent v0.2 databases: separate roles on the same physical PostgreSQL instance.
POSTGRES_AGENT_CONTROL_PASSWORD=REPLACE_AGENT_CONTROL_PASSWORD
POSTGRES_AGENT_RUNTIME_PASSWORD=REPLACE_AGENT_RUNTIME_PASSWORD
POSTGRES_GATEWAY_PASSWORD=REPLACE_GATEWAY_PASSWORD
AGENT_CONTROL_DATABASE_URL=postgres://teamie_agent_control:REPLACE_AGENT_CONTROL_PASSWORD@postgres:5432/teamie_agent_control?sslmode=disable
AGENT_RUNTIME_DATABASE_URL=postgres://teamie_agent_runtime:REPLACE_AGENT_RUNTIME_PASSWORD@postgres:5432/teamie_agent_runtime?sslmode=disable
GATEWAY_DATABASE_URL=postgres://teamie_gateway:REPLACE_GATEWAY_PASSWORD@postgres:5432/teamie_gateway?sslmode=disable
# Five independent internal credentials (openssl rand -hex 32 for EACH).
AGENT_RUNTIME_TOKEN=REPLACE_AGENT_RUNTIME_TOKEN
IM_PRINCIPAL_CONTROL_TOKEN=REPLACE_IM_PRINCIPAL_CONTROL_TOKEN
IM_PRINCIPAL_RUNTIME_TOKEN=REPLACE_IM_PRINCIPAL_RUNTIME_TOKEN
GATEWAY_RUNTIME_TOKEN=REPLACE_GATEWAY_RUNTIME_TOKEN
SANDBOX_RUNTIME_TOKEN=REPLACE_SANDBOX_RUNTIME_TOKEN
# AES-256-GCM key: exactly 64 hex characters. Retain securely outside DB backups.
# Never change it without decrypting/re-encrypting the stored provider credential.
GATEWAY_MASTER_KEY=REPLACE_GATEWAY_MASTER_KEY
# Shared foreground model-call cap across Agents; integer >= 2, default 16.
GATEWAY_MAX_CONCURRENT_CALLS=16
# Provider URL/model/API key are entered only through the authenticated admin UI.

# Structured ECS logs; debug includes healthy sync/RPC polling details.
LOG_LEVEL=info
