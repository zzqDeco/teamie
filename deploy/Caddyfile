{
	admin off
	default_sni {$TLS_SERVER_NAME}
}

{$SITE_ADDRESS} {
	import /etc/caddy/issuer.caddy
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}
	handle /internal/* {
		respond 404
	}
	@auth path /api/v1/auth/*
	handle @auth {
		reverse_proxy identity:8081
	}
	@gateway path /api/v1/admin/model-gateway /api/v1/admin/model-gateway/*
	handle @gateway {
		reverse_proxy llm-gateway:8086
	}
	@agents path /api/v1/agents /api/v1/agents/* /api/v1/workspaces/*/agents
	handle @agents {
		reverse_proxy agent-control:8084
	}
	@realtime path /api/v1/ws /api/v1/conversations/*/typing
	handle @realtime {
		reverse_proxy realtime:8083
	}
	handle /api/* {
		reverse_proxy chat:8082
	}
	handle {
		reverse_proxy web:80
	}
}

# Internal container liveness; this port is never published by Compose.
http://:8080 {
	respond /healthz "ok" 200
}
